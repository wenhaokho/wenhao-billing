# Copy this file to .env and adjust values for your environment.
# docker-compose.yml auto-loads .env from the repo root to fill ${VAR:-default}
# placeholders; anything left unset falls back to the dev-safe default baked
# into the compose file.

# --- Host port overrides (compose network -> your machine) ---
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- MCP remote server (rides on the backend uvicorn process at /mcp) ---
# Set to false to disable the MCP endpoint and OAuth routes entirely.
MCP_ENABLED=true
# HMAC secret for stateless confirm-tokens (email/delete gating). Generate a
# strong random value for production, e.g. `openssl rand -hex 32`.
MCP_CONFIRM_SECRET=change-me-mcp-confirm-secret
# Signing secret for OAuth access/refresh tokens. Generate a strong random
# value for production, e.g. `openssl rand -hex 32`. Never reuse dev values.
MCP_TOKEN_SECRET=change-me-mcp-token-secret
# Public origin the MCP endpoint and OAuth metadata are served from. In
# production this MUST be https://billing.wenhao.id (used to build the
# OAuth discovery/authorize/token URLs the MCP client sees).
MCP_PUBLIC_BASE_URL=http://localhost:8000
# Optional: token lifetimes in seconds (defaults shown).
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
