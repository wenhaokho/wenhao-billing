#!/usr/bin/env bash
# Development commands; only Docker is needed. GitHub Actions is off; scripts/check.sh runs it.
#   ./dev test [packages]   go test -p 8 -parallel 8, -race if GO_TEST_RACE=1 (default ./...)
#   ./dev lint | fmt        golangci-lint run | fmt
#   ./dev sqlc              regenerate the sqlc code from internal/*/queries.sql
#   ./dev openapi           write openapi.json for the frontend's generated types
#   ./dev generated         fail if the sqlc code or openapi.json is stale (scripts/check.sh)
#   ./dev vendor            update vendor/ (needs `gh auth login`; gokit is private)
#   ./dev go <args>         any go command
set -euo pipefail
# -race only when GO_TEST_RACE=1 (CI sets it): locally it multiplies each
# test binary's memory and build output inside the WSL VM.
race=; [[ "${GO_TEST_RACE:-}" == 1 ]] && race=-race
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")"

LINT_IMAGE=golangci/golangci-lint:v2.15.0
SQLC_IMAGE=sqlc/sqlc:1.31.1

if [[ -n "${MSYSTEM:-}" ]]; then export MSYS_NO_PATHCONV=1; here=$(pwd -W); else here=$(pwd); fi

# Go runs in the root docker-compose.yml (service `go`, profile tools) so it
# shares the dev stack's network; its tests use the db-test Postgres there.
# A PGTESTDB_URL set in the calling environment (even blank) overrides the
# service's default; check.sh's skip guard is tested by blanking it.
run_go() { docker compose -f ../docker-compose.yml --profile tools run --rm -T ${PGTESTDB_URL+-e PGTESTDB_URL} go "$@"; }

# test streams the source into the container with tar instead of reading it
# through the bind mount: on Docker Desktop go test's many small reads through
# the mount cost about 5 s a run, one tar well under a second.
# -parallel bounds each package's concurrent tests (each holds a database and
# a pool on db-test); -timeout fails a hung package long before anyone waits
# on it, while staying far above the slowest package (about 5 s).
test_flags=($race -p 8 -parallel 8 -timeout 60s)
in_copy='mkdir -p /tmp/src && tar -xf - -C /tmp/src && cd /tmp/src && exec "$@"'

case "${1:-}" in
  test) shift; tar -cf - . | run_go sh -c "$in_copy" sh go test "${test_flags[@]}" "${@:-./...}" ;;
  lint) docker run --rm -v "$here:/src" -w /src -e GOFLAGS=-mod=vendor "$LINT_IMAGE" golangci-lint run ./... ;;
  fmt) docker run --rm -v "$here:/src" -w /src -e GOFLAGS=-mod=vendor "$LINT_IMAGE" golangci-lint fmt ./... ;;
  sqlc) docker run --rm -v "$here:/src" -w /src "$SQLC_IMAGE" generate ;;
  openapi) run_go go run ./cmd/api openapi > openapi.json && echo "wrote openapi.json" ;;
  vendor)
    shift
    # ./dev vendor github.com/LOQATO/gokit@v0.2.0 upgrades, then vendors.
    cmd="go mod tidy && go mod vendor"
    if [[ $# -gt 0 ]]; then cmd="go get $* && $cmd"; fi
    token=$(gh auth token)
    # The token reaches git through environment variables for this one
    # command; nothing is written to a file.
    docker compose -f ../docker-compose.yml --profile tools run --rm -T \
      -e GOFLAGS=-mod=mod -e GOPRIVATE='github.com/LOQATO/*' -e GONOSUMDB='github.com/LOQATO/*' \
      -e GIT_CONFIG_COUNT=1 \
      -e GIT_CONFIG_KEY_0="url.https://x-access-token:${token}@github.com/.insteadOf" \
      -e GIT_CONFIG_VALUE_0="https://github.com/" \
      go sh -c "$cmd" ;;
  generated)
    # The committed sqlc code and openapi.json must match the sources: the
    # frontend's types are generated from openapi.json.
    "$self" sqlc >/dev/null
    "$self" openapi >/dev/null
    # Only the generated files are checked: the sqlc packages (each `out:` in
    # sqlc.yaml) and openapi.json. Other work in progress may be uncommitted.
    # git status, unlike git diff, also sees new untracked files and changes
    # already staged: the generated files must be committed as they are.
    generated=(openapi.json)
    while IFS= read -r out; do generated+=("$out"); done < <(sed -n 's/^[[:space:]]*out:[[:space:]]*\([^[:space:]#]*\).*/\1/p' sqlc.yaml)
    if [[ ${#generated[@]} -lt 2 ]]; then echo "no out: path found in sqlc.yaml"; exit 1; fi
    git diff --exit-code -- "${generated[@]}" || { echo "generated files are stale: run ./dev sqlc and ./dev openapi"; exit 1; }
    dirty=$(git status --porcelain -- "${generated[@]}")
    if [[ -n "$dirty" ]]; then
      echo "$dirty"
      echo "generated files are stale or uncommitted: run ./dev sqlc and ./dev openapi, then commit"
      exit 1
    fi ;;
  go) shift; run_go go "$@" ;;
  *) sed -n '2,9p' "$0"; exit 2 ;;
esac
