{
  "components": {
    "schemas": {
      "AccountCreate": {
        "additionalProperties": true,
        "properties": {
          "active": {
            "description": "Defaults to true.",
            "type": "boolean"
          },
          "code": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "ASSET",
              "LIABILITY",
              "EQUITY",
              "INCOME",
              "EXPENSE",
              "COGS"
            ],
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "type"
        ],
        "type": "object"
      },
      "AccountOut": {
        "additionalProperties": true,
        "properties": {
          "account_id": {
            "format": "int32",
            "type": "integer"
          },
          "active": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "ASSET",
              "LIABILITY",
              "EQUITY",
              "INCOME",
              "EXPENSE",
              "COGS"
            ],
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "code",
          "name",
          "type",
          "active"
        ],
        "type": "object"
      },
      "AccountUpdate": {
        "additionalProperties": true,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "code": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "ASSET",
              "LIABILITY",
              "EQUITY",
              "INCOME",
              "EXPENSE",
              "COGS"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChangePasswordRequest": {
        "additionalProperties": true,
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "maxLength": 128,
            "minLength": 6,
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "type": "object"
      },
      "ForgotPasswordRequest": {
        "additionalProperties": true,
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "ForgotPasswordResponse": {
        "additionalProperties": true,
        "properties": {
          "message": {
            "type": "string"
          },
          "reset_link": {
            "type": [
              "string",
              "null"
            ]
          },
          "reset_token": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "message",
          "reset_token",
          "reset_link"
        ],
        "type": "object"
      },
      "HealthOutBody": {
        "additionalProperties": true,
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": true,
        "properties": {
          "email": {
            "format": "email",
