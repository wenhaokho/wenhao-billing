          },
          "password": {
            "type": "string"
          },
          "remember": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "ProblemBody": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "status": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      },
      "ProblemDetail": {
        "additionalProperties": true,
        "properties": {
          "location": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "type": "object"
      },
      "ResetPasswordRequest": {
        "additionalProperties": true,
