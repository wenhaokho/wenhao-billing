          "new_password"
        ],
        "type": "object"
      },
      "UserOut": {
        "additionalProperties": true,
        "properties": {
          "created_at": {
            "examples": [
              "2026-01-01T03:00:00.123456Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "role",
          "display_name",
          "created_at"
        ],
        "type": "object"
      },
      "VendorCreate": {
        "additionalProperties": true,
        "properties": {
          "active": {
            "description": "Defaults to true.",
            "type": "boolean"
          },
          "contact_email": {
            "examples": [
              "ap@example.com"
            ],
            "maxLength": 255,
            "type": [
              "string",
              "null"
            ]
          },
          "contact_name": {
            "maxLength": 255,
            "type": [
              "string",
              "null"
            ]
          },
          "default_currency": {
            "description": "Defaults to IDR.",
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "payment_terms_days": {
            "description": "Defaults to 30.",
            "format": "int32",
            "maximum": 365,
            "minimum": 0,
            "type": "integer"
          },
          "tax_id": {
            "maxLength": 100,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "VendorOut": {
        "additionalProperties": true,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "contact_email": {
            "type": [
              "string",
              "null"
            ]
          },
          "contact_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "examples": [
              "2026-01-01T03:00:00.123456Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "default_currency": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "payment_terms_days": {
            "format": "int32",
            "type": "integer"
          },
          "tax_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "vendor_id": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "contact_email",
          "contact_name",
          "default_currency",
          "payment_terms_days",
          "tax_id",
          "notes",
          "active",
          "vendor_id",
          "created_at"
        ],
        "type": "object"
      },
      "VendorUpdate": {
        "additionalProperties": true,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "contact_email": {
            "examples": [
              "ap@example.com"
            ],
