# syntax=docker/dockerfile:1.7
# Single-image production build for Coolify: builds the Vue SPA, then bakes the
# static `dist/` into the FastAPI image so one container serves both API + UI.
# Build context is the REPO ROOT (see docker-compose.coolify.yml) so this can
# COPY from both frontend/ and backend/.

# ---------- stage 1: build the frontend ----------
FROM node:22-alpine AS frontend-build
WORKDIR /fe

# Install deps first (cached until package.json changes).
COPY frontend/package.json ./
RUN npm install

COPY frontend/ ./
# Produces /fe/dist (vue-tsc typecheck + vite build).
RUN npm run build

# ---------- stage 2: build Python deps into a venv ----------
FROM python:3.12-slim AS backend-build

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build tools for any deps that compile from source (psycopg/bcrypt fallbacks).
# They stay in this stage; the runtime image below never gets them.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

# Python deps (cached layer). Editable install with only pyproject present
# resolves/installs deps now and links the package via a .pth; the `app/`
# source copied into the runtime stage satisfies imports. WORKDIR matches the
# runtime stage so that link stays valid. No dev extras in prod.
WORKDIR /app
COPY backend/pyproject.toml ./
RUN pip install --upgrade pip \
    && pip install -e .

# ---------- stage 3: backend runtime (also serves the SPA) ----------
FROM python:3.12-slim AS backend

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/venv/bin:$PATH \
    FRONTEND_DIST=/app/frontend_dist

WORKDIR /app

# Runtime libpq only — no compilers or headers. Also upgrade the base image's
# system pip, which the scanner flags even though the app runs from the venv.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && /usr/local/bin/python -m pip install --upgrade pip

COPY --from=backend-build /opt/venv /opt/venv

# Headless Chromium for HTML->PDF invoice/quotation rendering (Playwright).
RUN python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

# Backend source.
COPY backend/ ./

# Built SPA from stage 1 — served by FastAPI when FRONTEND_DIST is set.
COPY --from=frontend-build /fe/dist /app/frontend_dist

EXPOSE 8000

# Bake the health check into the image so Coolify (and any orchestrator) reports
# a real health status even when it inspects the image rather than the compose
# file. Hits the always-on FastAPI /docs endpoint; start-period covers migrations.
HEALTHCHECK --interval=10s --timeout=5s --retries=20 --start-period=30s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/docs', timeout=2).read()" || exit 1

# Migrations are run by the compose `command:` before uvicorn starts.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
