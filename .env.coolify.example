# Env for docker-compose.coolify.yml (shared Postgres + Redis).
#
# On Coolify you normally DON'T need this file — Coolify generates the SERVICE_*
# secrets and domain automatically. You DO still set DATABASE_URL and REDIS_URL
# (pointing at your shared Postgres/Redis) in the Coolify UI.
#
# Copy to .env only when running the Coolify compose OUTSIDE Coolify, e.g. a
# local production smoke test:
#   cp .env.coolify.example .env
#   docker compose -f docker-compose.coolify.yml up --build

# --- Public domain (Coolify sets these from the service's configured domain) ---
# Host only, no scheme:
SERVICE_FQDN_APP_8000=billing.wenhao.id
# Full URL with scheme — used for MCP OAuth metadata, CORS, and email links:
SERVICE_URL_APP_8000=https://billing.wenhao.id

# --- Shared services (point at your existing Coolify Postgres + Redis) ---
# DATABASE_URL MUST use the postgresql+psycopg:// driver prefix. Host is the
# shared Postgres service's name/hostname on the shared Docker network.
DATABASE_URL=postgresql+psycopg://billing:change-me@shared-postgres:5432/billing
REDIS_URL=redis://shared-redis:6379/0

# --- App secrets (Coolify generates 64-char SERVICE_BASE64_64_* values) ---
# Generate locally with: openssl rand -base64 48
SERVICE_BASE64_64_SESSION=change-me-session-secret
SERVICE_BASE64_64_WEBHOOK=change-me-webhook-hmac-secret
SERVICE_BASE64_64_EMAILTOKEN=change-me-email-webhook-token
SERVICE_BASE64_64_MCPCONFIRM=change-me-mcp-confirm-secret
SERVICE_BASE64_64_MCPTOKEN=change-me-mcp-token-secret

# --- Optional tunables (defaults shown; safe to omit) ---
MCP_ENABLED=true
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Resend email (native API; recommended over SMTP on Coolify where outbound
# SMTP ports are often blocked). When RESEND_API_KEY is set it takes precedence
# over any SMTP_* settings. The sender domain must be verified in Resend. ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@wenhao.id
RESEND_FROM_NAME=Wenhao Dev Billing
