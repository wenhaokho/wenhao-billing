# Production web server for the SPA. Serves the built Vite `dist/` and proxies
# every backend path to the API container, so the browser still sees ONE origin:
# the session cookie, CORS and MCP/OAuth discovery URLs work unchanged.
#
# The nginx image runs envsubst on this template at start-up, substituting only
# variables that are set in the environment (BACKEND_UPSTREAM). nginx's own
# $variables below are left alone.

upstream backend {
    server ${BACKEND_UPSTREAM};
    keepalive 16;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Logo uploads and emailed receipts/OCR images go through here.
    client_max_body_size 25m;

    # Keep the original Host: FastMCP's DNS-rebinding guard allow-lists the
    # public host, and the OAuth login redirect is built from the request URL.
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Connection "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $http_host;

    # Backend paths. Matched by first path segment, so a client route such as
    # /mcp-integration still falls through to the SPA below.
    location ~ ^/(api|oauth|\.well-known)/ {
        proxy_pass http://backend;
    }
    location ~ ^/(docs|redoc|openapi\.json)$ {
        proxy_pass http://backend;
    }

    # MCP streamable-HTTP: responses are long-lived event streams, so no
    # buffering and a long read timeout. Bare /mcp is redirected by the API.
    location ~ ^/mcp(/|$) {
        proxy_pass http://backend;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Content-hashed bundles — replaced on every deploy, never change in place.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # History-mode client routes get the SPA shell. `no-cache` makes browsers and
    # the CDN revalidate it on every load, since it names the hashed bundles.
    location / {
        try_files $uri /index.html;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
