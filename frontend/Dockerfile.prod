# syntax=docker/dockerfile:1.7
# Production image for the SPA: builds the Vue app, then serves `dist/` with
# nginx, which also proxies the API paths to the backend container (see
# nginx.conf.template). Build context is frontend/.

# ---------- stage 1: build ----------
FROM node:22-alpine AS build
WORKDIR /fe

# Install deps first (cached until package.json changes).
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Vite inlines VITE_* vars at build time, so Sentry config arrives as build args.
ARG VITE_SENTRY_DSN=""
ARG VITE_SENTRY_ENVIRONMENT="production"
ARG VITE_SENTRY_TRACES_SAMPLE_RATE="0"
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN \
    VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT \
    VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE
# Produces /fe/dist (vue-tsc typecheck + vite build).
RUN npm run build

# ---------- stage 2: serve ----------
FROM nginx:1.27-alpine

# host:port of the API container on the compose network.
ENV BACKEND_UPSTREAM=backend:8000

COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /fe/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=5s \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
